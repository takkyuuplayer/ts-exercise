{
  "name": "ts-exercise",
  "version": "1.0.0",
  "license": "MIT",
  "author": "takkyuuplayer <takkyuuplayer@gmail.com>",
  "repository": "ssh://git@github.com/takkyuuplayer/ts-exercise.git",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "depcheck": "depcheck --ignores=@types/* ./",
    "lint": "biome check . --write --unsafe",
    "watch": "tsx watch src/index.ts",
    "pretest": "echo REDIS_URL=redis://localhost:$(docker compose port redis 6379 | cut -d: -f2) > .env",
    "test": "set -a && . ./.env && vp test run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/benchmark": "^2.1.5",
    "@types/bunyan": "^1.8.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/sinon": "^22.0.0",
    "@types/tmp": "^0.2.6",
    "benchmark": "^2.1.4",
    "bunyan": "^1.8.15",
    "depcheck": "^1.4.7",
    "express": "^5.2.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tmp": "^0.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  }
}
